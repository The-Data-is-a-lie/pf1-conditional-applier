# Passwords
.env

# OS / editor cruft
Thumbs.db
Desktop.ini
.DS_Store
*.swp
.vscode/
.idea/

# Python
__pycache__/
*.pyc

# Node (dev tooling only — nothing under node_modules ships)
node_modules/

# Release secrets read by release.ps1
.env

# The distributable zip. Built by release.ps1 and uploaded as a GitHub release asset, which is what
# module.json's "download" points at -- so it never needs to be committed. Tracking it would add
# ~500 KB of duplicate binary to git history on every single release.
downloads/

# LevelDB scratch inside the compendium packs. The pack DATA (*.ldb, the numbered *.log, CURRENT,
# MANIFEST-*) IS committed and shipped; these three are recreated on every open, so tracking them
# would dirty the tree every time Foundry runs.
packs/**/LOCK
packs/**/LOG
packs/**/LOG.old

# Local ticket/inventory scratch (to-tickets convention) -- working notes, never shipped.
.scratch/
