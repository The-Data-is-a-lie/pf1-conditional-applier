# The Foundry deploy copy bundle_macro.py writes on every build (src/load-latest.macro.js fetches
# it). Deliberately a DIFFERENT name from the tracked apply-conditionals.bundled.js: the deploy
# folder may be a clone of this repo, and a build writing a tracked file there would leave that
# checkout permanently dirty and block git pull.
apply-conditionals.deployed.js
