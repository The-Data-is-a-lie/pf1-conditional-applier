# OS / editor cruft
Thumbs.db
Desktop.ini
.DS_Store
*.swp
.vscode/
.idea/

# Python
__pycache__/
*.pyc

# Node (dev tooling only — nothing under node_modules ships)
node_modules/

# Release secrets read by release.ps1
.env

# LevelDB scratch inside the compendium packs. The pack DATA (*.ldb, the numbered *.log, CURRENT,
# MANIFEST-*) IS committed and shipped; these three are recreated on every open, so tracking them
# would dirty the tree every time Foundry runs.
packs/**/LOCK
packs/**/LOG
packs/**/LOG.old
